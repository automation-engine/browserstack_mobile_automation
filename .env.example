# Copy to .env.android. Shared Android settings are in config/android.defaults.json.
# For iOS, copy to .env.ios and add DEVICE_NAME, OS_VERSION and optional APP_ID / APP_PATH.
# Process environment > platform .env file > shared defaults.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_ID=

# Optional local overrides (uncomment only when needed):
# DEVICE_NAME=Google Pixel 8
# OS_VERSION=14.0
