{
  "name": "wikipedia-mobile-automation-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Wikipedia native mobile POC using WebdriverIO, Appium and BrowserStack",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm run test:android",
    "test:android": "cross-env PLATFORM=android wdio run ./wdio.conf.js",
    "test:ios": "cross-env PLATFORM=ios wdio run ./wdio.conf.js",
    "config:android": "cross-env PLATFORM=android node mobile/utils/validateConfig.js",
    "config:ios": "cross-env PLATFORM=ios node mobile/utils/validateConfig.js",
    "upload:android": "cross-env PLATFORM=android node mobile/utils/uploadApp.js",
    "upload:ios": "cross-env PLATFORM=ios node mobile/utils/uploadApp.js",
    "check": "node mobile/utils/check.js",
    "test:unit": "node --test config/environment.test.js",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "device:android": "cross-env PLATFORM=android node mobile/utils/selectDevice.js",
    "device:ios": "cross-env PLATFORM=ios node mobile/utils/selectDevice.js",
    "setup:android": "npm run device:android && npm run upload:android",
    "setup:ios": "npm run device:ios && npm run upload:ios",
    "test:both": "npm run test:android && npm run test:ios"
  },
  "devDependencies": {
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/allure-reporter": "^10.1.0",
    "webdriverio": "^10.1.0",
    "appium": "^3.0.0",
    "allure-commandline": "^2.34.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.0.0"
  }
}
